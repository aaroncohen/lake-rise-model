# Copy to .env (which is gitignored) and fill in. Real shell env vars override these.
# Create the token in Home Assistant: Profile -> Long-Lived Access Tokens.

# --- Runtime (passed into the container by docker-compose / deploy.sh) ---
LAKE_RISE_PORT=8077
# When deployed on the NAS with host networking, HA is reachable on localhost:
HA_URL=http://127.0.0.1:8123
HA_TOKEN=your-long-lived-access-token

# Optional overrides (defaults match the Crystal Lake setup):
# LAKE_RISE_LAKE_SENSOR=sensor.crystal_lake_depth_smoothed
# LAKE_RISE_RAIN_SENSOR=sensor.gw3000b_hourly_rain_piezo
# LAKE_RISE_FORECAST_ENTITY=weather.47_77849_122_10882
# LAKE_RISE_STOPLOG_HELPER=
# LAKE_RISE_ARTIFACT=artifacts/crystal_lake_v0.json
# Gauge liveness is judged from this raw, least-rounded sensor (NOT the smoothed depth,
# which rounds to 0.01 ft and can hold steady for 30+ min in calm water and look "stale").
# LAKE_RISE_LAKE_FRESH_SENSOR=sensor.gw3000b_air_gap_1
# Minutes without a report from the liveness sensor before flagging readings stale.
# Default 15 — the raw air gap moves every ~1-7 min, so 15 clears normal cadence while
# still catching a real hardware dropout quickly.
# LAKE_RISE_LAKE_STALE_MINUTES=15

# --- Alerting (optional; off unless ALERT_ENABLED=1) ---------------------------
# The server runs the lake-rise simulation hourly, evaluates threshold-crossing risk
# over a 3-day horizon, and notifies ONLY when the situation crosses up into a new,
# higher level (never repeated hourly while sitting at the same level).
# ALERT_ENABLED=1
# ALERT_INTERVAL_MINUTES=60          # how often the simulation runs
# ALERT_OBSERVED_INTERVAL_MINUTES=5  # rolling 15-min observed EAP gauge check
# ALERT_HORIZON_HOURS=72             # forecast look-ahead (3 days)
# ALERT_TIMEZONE=America/Los_Angeles # all alert times are formatted in this zone
# ALERT_SEND_ALL_CLEAR=1             # one-shot notice when risk returns to normal
# ALERT_STATE_PATH=artifacts/alert_state.json
# ALERT_UI_BASE_URL=http://your-nas:8077   # used for the "Visualize this forecast" link
# Shared secret to trigger a REAL send via POST /alert/run?dry_run=false (sent as the
# X-Alert-Token header). The hourly scheduler and local CLI never need it. If UNSET, the
# HTTP send path is disabled entirely (preview/dry-run stays open) — so a random visitor
# can't trigger alerts. Set this only if something (e.g. Home Assistant) triggers sends via HTTP.
# ALERT_API_TOKEN=change-me-to-a-long-random-string

# Escalation ladder: ordered, increasing severity. name:threshold_label:min_prob:audience
# threshold_label is a level in the artifact (early_warning / dam_crest / bridge_deck); min_prob
# is the probability cutoff; audience names a recipient group below. Recipients are cumulative,
# so severe levels also reach the smaller initial audiences. dam_crest = initial dam overtopping
# (bridge closure); bridge_deck = bridge-deck overtopping = the EAP "imminent failure" / evacuate.
# ALERT_LEVELS=ADVISORY:early_warning:0.30:ops,WARNING:early_warning:0.60:ops,WATCH:dam_crest:0.10:ops,DANGER:dam_crest:0.30:emergency,CRITICAL:dam_crest:0.60:road,EVACUATE:bridge_deck:0.30:evacuate

# Audience groups (comma lists). Define one _EMAIL and/or _SMS per group used above.
# ALERT_AUDIENCE_OPS_EMAIL=ops@example.org
# ALERT_AUDIENCE_OPS_SMS=+15551230000
# ALERT_AUDIENCE_EMERGENCY_EMAIL=eoc@example.org
# ALERT_AUDIENCE_EMERGENCY_SMS=+15551231111
# ALERT_AUDIENCE_ROAD_SMS=+15551232222     # road-closure contacts; added at overtopping levels
# ALERT_AUDIENCE_EVACUATE_SMS=+15551233333  # NORCOM/KCDOT; added at bridge-deck overtop (evacuate)

# Observed EAP notifications are independent of forecast alerts and use the same audiences:
# 15-minute average >=3.30 ft adds emergency, >=3.90 adds road, >=4.40 adds evacuate.
# Each level fires once per continuous event. The track re-arms only after the average
# remains below 3.25 ft for 30 minutes; these fixed values mirror operational EAP policy.

# Toggleable test-level alert: fires (to its own audience) whenever more than a little
# rain enters the forecast, with the SAME full detail as a real warning -> validates the
# end-to-end pipeline. Independent of the ladder.
# ALERT_TEST_ENABLED=1
# ALERT_TEST_RAIN_IN=0.10
# ALERT_TEST_AUDIENCE=test
# ALERT_AUDIENCE_TEST_EMAIL=you@example.org

# Monthly pipeline-check email: fires once, to the configured audience, on/after
# ALERT_MONTHLY_TEST_DOM at/after ALERT_MONTHLY_TEST_HOUR -- both local to ALERT_TIMEZONE,
# not UTC (UTC's day rollover lands 7-8h before local midnight, which would otherwise send
# it the evening before, misattributed to the wrong month). Independent of rain (unlike
# ALERT_TEST_ENABLED above) and of the ladder/observed-EAP state. The fire-once guard
# (last_monthly_test_ym) is persisted to ALERT_STATE_PATH, so an app restart mid-month
# does not re-send it.
# ALERT_MONTHLY_TEST_ENABLED=1
# ALERT_MONTHLY_TEST_DOM=1           # day-of-month on/after which it fires (1–28), local time
# ALERT_MONTHLY_TEST_HOUR=7          # hour-of-day on/after which it fires (0–23), local time
# ALERT_MONTHLY_TEST_AUDIENCE=ops    # audience group (must have email/SMS configured)

# Monthly communications drill: sends a 5-step Advisory → Danger → Critical → Evac Notice →
# All Clear sequence to the drill audience once per month, on or after ALERT_DRILL_DOM.
# All messages are prominently labelled "MONTHLY COMMUNICATIONS DRILL — THIS IS ONLY A TEST".
# Entirely independent of the real alert state machine (no effect on level_rank or crossing logic).
# Run `lake-rise alert-drill --dry-run` to preview the sequence without sending.
# ALERT_DRILL_ENABLED=1
# ALERT_DRILL_DOM=1           # day-of-month on/after which the drill fires (1–28)
# ALERT_DRILL_AUDIENCE=ops    # audience group that receives the drill (must have email/SMS configured)

# Channels + credentials.
# ALERT_CHANNELS=email,sms
# ALERT_TEMPLATE_DIR=                # override the built-in notice templates (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=1
# SMTP_USER=you@example.org
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=alerts@crystal-lake.org
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your-token
# TWILIO_FROM=+15550009999

# --- Automated calibration (signature-based; human-approved, versioned) ---
# When enabled, the server hourly appends the live HA window to a continuous record
# (data/continuous) so the calibration signatures accumulate. Training/approval stay
# operator-driven: `lake-rise calibration train` proposes, you approve, it versions.
CALIB_ENABLED=0
CALIB_RECIPIENT=          # operator email that receives a proposal (SMTP_* reused from alerting)
CALIB_BFI_TARGET=0.67     # Wolock baseflow-index target for the percolation solve
CALIB_MIN_RECESSION_DAYS=5
CALIB_BACKFILL_DAYS=400   # on startup, pull this much history into the archive (HA returns what it retains)
# CALIB_STATE_PATH=artifacts/calibration_state.json
# CALIB_VERSIONS_PATH=artifacts/versions
# CALIB_TEMPLATE_PATH=    # override the report templates
# CALIB_API_TOKEN=        # enables POST /calibration/approve (the emailed link); else CLI-only
# CALIB_UI_BASE_URL=

# --- Deploy (used only by deploy.sh; NOT copied to the NAS) ---
SSH_HOST=your-nas-hostname-or-ip
SSH_PORT=22
SSH_USER=your-ssh-user
SSH_PASSWORD=your-ssh-password
NAS_DEPLOY_DIR=/volume2/docker/lake-rise
IMAGE_TAG=latest
